# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Authentication and email
EMAIL_CODE_SECRET=replace-with-a-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASSWORD=your-password
SMTP_FROM=your-sender@example.com

# Production
CORS_ORIGINS=https://your-frontend.example.com
CONFIG_DATA_PATH=/data/dados_configuracoes.json

# AI (services/ai) — mecanismo de inferência para correção de redações
# AI_PROVIDER: ollama | openai_compatible (vLLM, ou qualquer servidor compatível com a API da OpenAI)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:14b
AI_TIMEOUT=60
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3
